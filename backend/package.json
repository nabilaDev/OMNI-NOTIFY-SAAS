{
  "name": "omni-notify-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "High-performance real-time notification engine with Node.js, Express and Socket.io",
  "main": "src/server.ts",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "node --loader ts-node/esm --watch src/server.ts",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "simulate": "node scripts/simulate-notifications.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nabilaDev/omni-notify-saas.git"
  },
  "keywords": [
    "notification-engine",
    "real-time",
    "websocket",
    "socketio",
    "nodejs",
    "typescript",
    "mongodb",
    "saas",
    "tech-lead"
  ],
  "author": "Nabila Salhi <salhinabila1@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nabilaDev/omni-notify-saas/issues"
  },
  "homepage": "https://github.com/nabilaDev/omni-notify-saas#readme",
  "dependencies": {
    "axios": "^1.16.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.23.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.19.39",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
