# MongoDB Configuration
MONGODB_URI=mongodb://omni-db:27017/omni-notify

# JWT Configuration (Générer une clé aléatoire sécurisée)
JWT_SECRET=votre_secret_aleatoire_tres_securise_minimum_32_caracteres

# Frontend URL (pour CORS)
FRONTEND_URL=http://localhost:4200

# Test Token (pour stress-test.js et simulate-notifications.cjs)
# Obtenir via: POST /api/auth/login { email: "test@example.com", password: "password" }
TEST_TOKEN=

# API URL (pour les scripts de test)
API_URL=http://localhost:3000/api/notifications

# Port du serveur
PORT=3000
